		build-gui/dbcontroller.o \
		build-gui/notebookmodel.o \
		build-gui/notemodel.o \
		build-gui/qrc_qml.o \
		build-gui/moc_dbcontroller.o \
		build-gui/moc_notebookmodel.o \
		build-gui/moc_notemodel.o
