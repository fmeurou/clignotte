clignotte-gui.pro:
gui/qml.qrc:
/usr/lib/libQt6QuickControls2.prl:
/usr/lib/libQt6Quick.prl:
/usr/lib/libQt6OpenGL.prl:
/usr/lib/libQt6Gui.prl:
/usr/lib/libQt6Sql.prl:
/usr/lib/libQt6Qml.prl:
/usr/lib/libQt6Network.prl:
/usr/lib/libQt6Core.prl:
qmake: FORCE
	@$(QMAKE) -o Makefile.gui clignotte-gui.pro

qmake_all: FORCE


all: Makefile.gui note-gui

dist: distdir FORCE
	(cd `dirname $(DISTDIR)` && $(TAR) $(DISTNAME).tar $(DISTNAME) && $(COMPRESS) $(DISTNAME).tar) && $(MOVE) `dirname $(DISTDIR)`/$(DISTNAME).tar.gz . && $(DEL_FILE) -r $(DISTDIR)

distdir: FORCE
	@test -d $(DISTDIR) || mkdir -p $(DISTDIR)
	$(COPY_FILE) --parents $(DIST) $(DISTDIR)/
	$(COPY_FILE) --parents gui/qml.qrc $(DISTDIR)/
	$(COPY_FILE) --parents /usr/lib/qt6/mkspecs/features/data/dummy.cpp $(DISTDIR)/
	$(COPY_FILE) --parents gui/dbcontroller.h gui/notebookmodel.h gui/notemodel.h $(DISTDIR)/
	$(COPY_FILE) --parents gui/main.cpp gui/dbcontroller.cpp gui/notebookmodel.cpp gui/notemodel.cpp $(DISTDIR)/


clean: compiler_clean 
	-$(DEL_FILE) $(OBJECTS)
	-$(DEL_FILE) *~ core *.core


distclean: clean 
	-$(DEL_FILE) $(TARGET) 
	-$(DEL_FILE) .qmake.stash
	-$(DEL_FILE) Makefile.gui


####### Sub-libraries

mocclean: compiler_moc_header_clean compiler_moc_objc_header_clean compiler_moc_source_clean

mocables: compiler_moc_header_make_all compiler_moc_objc_header_make_all compiler_moc_source_make_all

check: first

benchmark: first

compiler_rcc_make_all: build-gui/qrc_qml.cpp
compiler_rcc_clean:
	-$(DEL_FILE) build-gui/qrc_qml.cpp
build-gui/qrc_qml.cpp: gui/qml.qrc \
		/usr/lib/qt6/rcc \
		gui/qml/Main.qml \
		gui/qml/NoteList.qml \
		gui/qml/NoteEditor.qml
	/usr/lib/qt6/rcc -name qml gui/qml.qrc -o build-gui/qrc_qml.cpp

compiler_moc_predefs_make_all: build-gui/moc_predefs.h
compiler_moc_predefs_clean:
	-$(DEL_FILE) build-gui/moc_predefs.h
build-gui/moc_predefs.h: /usr/lib/qt6/mkspecs/features/data/dummy.cpp
	g++ -pipe -O2 -std=gnu++1z -Wall -Wextra -dM -E -o build-gui/moc_predefs.h /usr/lib/qt6/mkspecs/features/data/dummy.cpp

compiler_moc_header_make_all: build-gui/moc_dbcontroller.cpp build-gui/moc_notebookmodel.cpp build-gui/moc_notemodel.cpp
compiler_moc_header_clean:
	-$(DEL_FILE) build-gui/moc_dbcontroller.cpp build-gui/moc_notebookmodel.cpp build-gui/moc_notemodel.cpp
build-gui/moc_dbcontroller.cpp: gui/dbcontroller.h \
		gui/notebookmodel.h \
		gui/notemodel.h \
		build-gui/moc_predefs.h \
		/usr/lib/qt6/moc
	/usr/lib/qt6/moc $(DEFINES) --include /home/laaapin/Sources/clignotte/build-gui/moc_predefs.h -I/usr/lib/qt6/mkspecs/linux-g++ -I/home/laaapin/Sources/clignotte -I/usr/include/qt6 -I/usr/include/qt6/QtQuickControls2 -I/usr/include/qt6/QtQuick -I/usr/include/qt6/QtOpenGL -I/usr/include/qt6/QtGui -I/usr/include/qt6/QtSql -I/usr/include/qt6/QtQml -I/usr/include/qt6/QtQmlIntegration -I/usr/include/qt6/QtNetwork -I/usr/include/qt6/QtCore -I/usr/include/c++/16.1.1 -I/usr/include/c++/16.1.1/x86_64-pc-linux-gnu -I/usr/include/c++/16.1.1/backward -I/usr/lib/gcc/x86_64-pc-linux-gnu/16.1.1/include -I/usr/local/include -I/usr/include gui/dbcontroller.h -o build-gui/moc_dbcontroller.cpp

build-gui/moc_notebookmodel.cpp: gui/notebookmodel.h \
		build-gui/moc_predefs.h \
		/usr/lib/qt6/moc
