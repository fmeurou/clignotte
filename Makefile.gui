####### Compile

build-gui/main.o: gui/main.cpp gui/dbcontroller.h \
		gui/notebookmodel.h \
		gui/notemodel.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o build-gui/main.o gui/main.cpp

build-gui/dbcontroller.o: gui/dbcontroller.cpp gui/dbcontroller.h \
		gui/notebookmodel.h \
		gui/notemodel.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o build-gui/dbcontroller.o gui/dbcontroller.cpp

build-gui/notebookmodel.o: gui/notebookmodel.cpp gui/notebookmodel.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o build-gui/notebookmodel.o gui/notebookmodel.cpp

build-gui/notemodel.o: gui/notemodel.cpp gui/notemodel.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o build-gui/notemodel.o gui/notemodel.cpp

build-gui/qrc_qml.o: build-gui/qrc_qml.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o build-gui/qrc_qml.o build-gui/qrc_qml.cpp

build-gui/moc_dbcontroller.o: build-gui/moc_dbcontroller.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o build-gui/moc_dbcontroller.o build-gui/moc_dbcontroller.cpp

build-gui/moc_notebookmodel.o: build-gui/moc_notebookmodel.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o build-gui/moc_notebookmodel.o build-gui/moc_notebookmodel.cpp

build-gui/moc_notemodel.o: build-gui/moc_notemodel.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o build-gui/moc_notemodel.o build-gui/moc_notemodel.cpp

####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/usr/local/bin || mkdir -p $(INSTALL_ROOT)/usr/local/bin
	$(QINSTALL_PROGRAM) $(QMAKE_TARGET) $(INSTALL_ROOT)/usr/local/bin/$(QMAKE_TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) $(INSTALL_ROOT)/usr/local/bin/$(QMAKE_TARGET)
	-$(DEL_DIR) $(INSTALL_ROOT)/usr/local/bin/ 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

FORCE:

.SUFFIXES:

