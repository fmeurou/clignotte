pkgbase = clignotte
	pkgdesc = A small note keeper backed by SQLite with FTS5 search — CLI and Qt Quick GUI
	pkgver = 1.0.0
	pkgrel = 1
	url = https://github.com/fmeurou/clignotte
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = git
	depends = qt6-base
	depends = qt6-declarative
	optdepends = python-openai-whisper: transcribe audio files via "note import <audio>"
	optdepends = tesseract: OCR image files via "note import <image>"
	optdepends = tesseract-data-eng: English language data for tesseract (recommended with tesseract)
	optdepends = poppler: convert PDF pages for OCR via "note import <pdf>" (provides pdftoppm)
	source = git+https://github.com/fmeurou/clignotte.git
	sha256sums = SKIP

pkgname = clignotte
